diff --git a/src/flat.c b/src/flat.c
--- a/src/flat.c
+++ b/src/flat.c
@@ -19,6 +19,7 @@
 #include "system4.h"
+#include "system4/qnt.h"
 #include "system4/ajp.h"
--- a/src/flat.c
+++ b/src/flat.c
@@ -139,8 +140,17 @@
 
-		if (strncmp(buffer_strdata(&r), "AJP", 4) != 0)
-			WARNING("File in flat TALT section is not ajp format");

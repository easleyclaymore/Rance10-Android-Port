+			 * WARNING（实测每轮 63 条）。认得出的格式（AJP/QNT）
+			 * 不响，真正未知的把魔数打出来。 */
+			WARNING("File in flat TALT section has unknown format "
+				"%02x %02x %02x %02x",
+				(unsigned char)buffer_strdata(&r)[0],
+				(unsigned char)buffer_strdata(&r)[1],
+				(unsigned char)buffer_strdata(&r)[2],
+				(unsigned char)buffer_strdata(&r)[3]);

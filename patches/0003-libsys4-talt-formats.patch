diff --git a/src/flat.c b/src/flat.c
--- a/src/flat.c
+++ b/src/flat.c
@@ -19,6 +19,7 @@
 #include "little_endian.h"
 #include "system4.h"
 #include "system4/ajp.h"
+#include "system4/qnt.h"
 #include "system4/buffer.h"
 #include "system4/file.h"
 #include "system4/flat.h"
@@ -136,8 +137,19 @@
 		fl->talt_entries[i].size = buffer_read_int32(&r);
 		fl->talt_entries[i].off = fl->talt.off + r.index + 8;
 
-		if (strncmp(buffer_strdata(&r), "AJP", 4) != 0)
-			WARNING("File in flat TALT section is not ajp format");
+		if (strncmp(buffer_strdata(&r), "AJP", 4) != 0 &&
+		    !qnt_checkfmt((const uint8_t *)buffer_strdata(&r)))
+			/* [D496] TALT 条目不只是 AJP：QNT 也会出现（消费端
+			 * xsystem4 flat.c D275 按 cg_check_format 全格式处理，
+			 * D200 的原始判据就是 QNT）。上游硬编码 AJP 对 QNT 刷
+			 * WARNING（实测每轮 63 条）。认得出的格式（AJP/QNT）
+			 * 不响，真正未知的把魔数打出来。 */
+			WARNING("File in flat TALT section has unknown format "
+				"%02x %02x %02x %02x",
+				(unsigned char)buffer_strdata(&r)[0],
+				(unsigned char)buffer_strdata(&r)[1],
+				(unsigned char)buffer_strdata(&r)[2],
+				(unsigned char)buffer_strdata(&r)[3]);
 
 		buffer_skip(&r, fl->talt_entries[i].size);
 		buffer_align(&r, 4);

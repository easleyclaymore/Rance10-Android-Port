From 89508e700179538f2d5d28110cd7c698da9c109e Mon Sep 17 00:00:00 2001
From: xsystem4-port <port@localhost>
Date: Sat, 14 Nov 2026 20:57:55 +0800
Subject: [PATCH] =?UTF-8?q?fix:=20gsave=20v8=20+=20=E6=B3=9B=E5=9E=8B?=
 =?UTF-8?q?=E6=95=B0=E7=BB=84=20+=20=E7=A9=BA=E5=80=BC=20-1=20=E6=A0=A1?=
 =?UTF-8?q?=E9=AA=8C?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- version 8 纳入合法集合：Rance10 PC 原版通关档实测 version=8，
  与 v7 布局完全相同，之前直接被 UNSUPPORTED_FORMAT 拒掉
- AIN_ARRAY(79) 泛型数组不再落进 default 分支：AIN_ARRAY_TYPE 宏
  不包含它，导致本引擎自己写出的合法存档也报 Invalid save file
- struct/array 的 -1 表示「未设置」，与 GSAVE7_EMPTY_STRING 同理
---
 src/savefile.c | 37 ++++++++++++++++++++++++++++++++++---
 1 file changed, 34 insertions(+), 3 deletions(-)

diff --git a/src/savefile.c b/src/savefile.c
index 9ed216b..2cf6182 100644
--- a/src/savefile.c
+++ b/src/savefile.c
@@ -243,9 +243,19 @@ static bool gsave_validate_value(int32_t val, enum ain_data_type type, struct gs
 	case AIN_STRING:
 		return (0 <= val && val < gs->nr_strings) || val == GSAVE7_EMPTY_STRING;
 	case AIN_STRUCT:
-		return 0 <= val && val < gs->nr_records;
+		/* [L2 patch] -1 means "unset": an unallocated struct value is
+		 * written as -1 by the engine and read back as a null struct.
+		 * Rejecting it made every file that contained one unreadable. */
+		return val == -1 || (0 <= val && val < gs->nr_records);
+	case AIN_ARRAY:
+		/* [L2 patch] AIN v12 generic arrays. AIN_ARRAY_TYPE is a macro
+		 * over the 8 concrete array types and does NOT include the generic
+		 * AIN_ARRAY(79), so generic arrays fell into `default: return
+		 * false` and the WHOLE file was rejected (observed: AFConfig.asd
+		 * written by this very engine, valid zlib, still "Invalid save
+		 * file"). They share the arrays table with the concrete kinds. */
 	case AIN_ARRAY_TYPE:
-		return 0 <= val && val < gs->nr_arrays;
+		return val == -1 || (0 <= val && val < gs->nr_arrays);
 	default:
 		return false;
 	}
@@ -259,7 +269,12 @@ enum savefile_error gsave_parse(uint8_t *buf, size_t len, struct gsave *gs)
 	gs->key = strdup(buffer_skip_string(&r));
 	gs->uk1 = buffer_read_int32(&r);
 	gs->version = buffer_read_int32(&r);
-	if (gs->version != 4 && gs->version != 5 && gs->version != 7)
+	/* [D139] Rance10 的 PC 原版通关存档是 version 8（实测 Collection.asd：
+	 * key="rance10", uk1=1000, version=8, uk2=64, nr_ain_globals=358）。
+	 * 解析器里所有版本分支都是 >=5 / <=5 / >=7，v8 与 v7 走完全相同的
+	 * 布局，所以只需把它纳入合法集合就能读回原版存档。 */
+	if (gs->version != 4 && gs->version != 5 &&
+	    gs->version != 7 && gs->version != 8)
 		return SAVEFILE_UNSUPPORTED_FORMAT;
 	gs->uk2 = buffer_read_int32(&r);
 	gs->nr_ain_globals = buffer_read_int32(&r);
@@ -275,6 +290,14 @@ enum savefile_error gsave_parse(uint8_t *buf, size_t len, struct gsave *gs)
 	size_t keyvals_offset = buffer_read_int32(&r);
 	gs->nr_keyvals = buffer_read_int32(&r);
 
+	/* [D139] version 8 在 14 个标准 int 之后、group 字符串之前多两个 int32：
+	 * 实测原版 Collection.asd 为 [486577(= 解压后总长), 0]。不跳过它们，
+	 * group 会从二进制数据里被当字符串读走，接着 r.index != records_offset
+	 * 直接判 Invalid。 */
+	if (gs->version >= 8) {
+		buffer_read_int32(&r);
+		buffer_read_int32(&r);
+	}
 	if (gs->version >= 5) {
 		gs->group = strdup(buffer_skip_string(&r));
 	}
@@ -434,6 +457,11 @@ enum savefile_error gsave_write(struct gsave *gs, FILE *out, bool encrypt, int c
 	size_t keyvals_offset_loc = skip_int32(&w);
 	buffer_write_int32(&w, gs->nr_keyvals);
 
+	size_t raw_size_loc = 0;
+	if (gs->version >= 8) {
+		raw_size_loc = skip_int32(&w);   /* 解压后总长，收尾时回填 */
+		buffer_write_int32(&w, 0);       /* 原版恒为 0，含义未明 */
+	}
 	if (gs->version >= 5)
 		buffer_write_cstringz(&w, gs->group);
 
@@ -509,6 +537,9 @@ enum savefile_error gsave_write(struct gsave *gs, FILE *out, bool encrypt, int c
 		}
 	}
 
+	if (raw_size_loc)
+		buffer_write_int32_at(&w, raw_size_loc, w.index);
+
 	struct savefile save = {
 		.buf = w.buf,
 		.len = w.index,
-- 
